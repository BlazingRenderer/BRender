prefix=@BRENDER_PC_PREFIX@
libdir="@BRENDER_PC_LIBDIR@"
includedir="@BRENDER_PC_INCLUDEDIR@"

Name: @PROJECT_NAME@ (@driver@ driver)
Description: @CMAKE_PROJECT_DESCRIPTION@
URL: @CMAKE_PROJECT_HOMEPAGE_URL@
