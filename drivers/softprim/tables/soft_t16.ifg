# softprim's restored z-buffered native RGB 565 triangle family.
#
# The 565 twin of soft_t15.ifg, and the same argument applies: it carries the
# prm_t16 rows MMX-off pentprim selects for a z-buffered 565 output and is
# listed before mmx_t16 so the MMX untextured rows do not take the state first.
# See soft_t15.ifg for the match contract, the two shapes that reach these rows
# (an RGB_565 colour map, or an INDEX_8 map with an RGB_565 shade table), the
# size rows' precedence over the arbitrary-width row and the 256x256 shade-table
# exclusion.
[texture_stride_positive,texture_no_skip]
softhz:TriangleRender_ZT_RGB565_D16_1024 = [z_buffered, triangle, rgb565, texture1024x1024, perspective_subdivide]
softhz:TriangleRender_ZT_RGB565_D16_256 = [z_buffered, triangle, rgb565, texture256x256, perspective_subdivide]
softhz:TriangleRender_ZT_RGB565_D16_128 = [z_buffered, triangle, rgb565, texture128x128, perspective_subdivide]
softhz:TriangleRender_ZT_RGB565_D16_64 = [z_buffered, triangle, rgb565, texture64x64, perspective_subdivide]
softhz:TriangleRender_ZT_RGB565_D16_32 = [z_buffered, triangle, rgb565, texture32x32, perspective_subdivide]

[texture_stride_positive,fixed_components]
softhz:TriangleRenderPIZ2TA16 = [z_buffered, triangle, rgb565, texture, perspective_subdivide]
softhz:TriangleRenderPIZ2TIA_RGB_565 = [z_buffered, triangle, rgb565, texture, texture_index8, perspective_subdivide, constant_intensity, duplicate, texture_not_size=256]
softhz:TriangleRenderPIZ2TIA_RGB_565 = [z_buffered, triangle, rgb565, texture, texture_index8, perspective_subdivide, interpolated_intensity, texture_not_size=256]

[texture_stride_positive,texture_no_skip]
softhz:TriangleRender_ZT_RGB565_D16_1024 = [z_buffered, triangle, rgb565, texture1024x1024]
softhz:TriangleRender_ZT_RGB565_D16_256 = [z_buffered, triangle, rgb565, texture256x256]
softhz:TriangleRender_ZT_RGB565_D16_128 = [z_buffered, triangle, rgb565, texture128x128]
softhz:TriangleRender_ZT_RGB565_D16_64 = [z_buffered, triangle, rgb565, texture64x64]
softhz:TriangleRender_ZT_RGB565_D16_32 = [z_buffered, triangle, rgb565, texture32x32]

[texture_stride_positive,fixed_components]
softhz:TriangleRenderPIZ2TA16 = [triangle, z_buffered, rgb565, texture]
softhz:TriangleRenderPIZ2TIA_RGB_565 = [triangle, z_buffered, rgb565, texture, texture_index8, interpolated_intensity, texture_not_size=256]
softhz:TriangleRenderPIZ2TIA_RGB_565 = [triangle, z_buffered, rgb565, texture, texture_index8, constant_intensity, duplicate, texture_not_size=256]
